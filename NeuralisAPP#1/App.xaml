<?xml version="1.0" encoding="utf-8" ?>
<Application
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:NeuralisAPP_1.Resources.Converters"
    x:Class="NeuralisAPP_1.App">

    <Application.Resources>
        <ResourceDictionary>

            <!-- 🔗 Подключаем словари -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
                <ResourceDictionary Source="Resources/Styles/AuthStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- 🔁 Конвертеры -->
            <converters:BoolToStatusConverter x:Key="BoolToStatusConverter"/>
            <converters:BlockButtonTextConverter x:Key="BlockButtonTextConverter"/>

        </ResourceDictionary>
    </Application.Resources>

</Application>
