<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:docvm="clr-namespace:NeuralisAPP_1.ViewModels.Doctor"
    x:Class="NeuralisAPP_1.Views.Doctor.DoctorLabResultsPage"
    x:Name="LabResultsRoot"
    BackgroundColor="#020617">

    <Grid ColumnDefinitions="260,*">

		<!-- ================= SIDEBAR ================= -->
		<Grid Grid.Column="0"
      BackgroundColor="#0f172a"
      Padding="20,28"
      RowDefinitions="Auto,*,Auto">

			<!-- LOGO -->
			<HorizontalStackLayout Spacing="12">
				<Ellipse WidthRequest="28" HeightRequest="28" Fill="#2dd4bf"/>
				<VerticalStackLayout>
					<Label Text="NEURALIS"
                   FontSize="16"
                   FontAttributes="Bold"
                   TextColor="#e5e7eb"/>
					<Label Text="AI MEDICAL SYSTEM"
                   FontSize="9"
                   TextColor="#94a3b8"/>
				</VerticalStackLayout>
			</HorizontalStackLayout>

			<!-- NAV -->
			<VerticalStackLayout Grid.Row="1"
                         Margin="0,36,0,0"
                         Spacing="10">

				<!-- DASHBOARD -->
				<Border x:Name="NavDashboard"
                Padding="10"
                StrokeShape="RoundRectangle 12"
                BackgroundColor="Transparent">

					<HorizontalStackLayout Spacing="12">
						<Label Text="dashboard"
                       FontFamily="MaterialIcons"
                       FontSize="20"
                       TextColor="#9ca3af"/>
						<Label Text="Dashboard"
                       TextColor="#9ca3af"/>
					</HorizontalStackLayout>

					<Border.GestureRecognizers>
						<TapGestureRecognizer Tapped="OnDashboardTapped"/>
						<PointerGestureRecognizer
                    PointerEntered="OnNavPointerEntered"
                    PointerExited="OnNavPointerExited"/>
					</Border.GestureRecognizers>
				</Border>

				<!-- PATIENTS -->
				<Border x:Name="NavPatients"
                Padding="10"
                StrokeShape="RoundRectangle 12"
                BackgroundColor="Transparent">

					<HorizontalStackLayout Spacing="12">
						<Label Text="people"
                       FontFamily="MaterialIcons"
                       FontSize="20"
                       TextColor="#9ca3af"/>
						<Label Text="Patients"
                       TextColor="#9ca3af"/>
					</HorizontalStackLayout>

					<Border.GestureRecognizers>
						<TapGestureRecognizer Tapped="OnPatientsTapped"/>
						<PointerGestureRecognizer
                    PointerEntered="OnNavPointerEntered"
                    PointerExited="OnNavPointerExited"/>
					</Border.GestureRecognizers>
				</Border>

				<!-- LAB RESULTS (ACTIVE) -->
				<Border x:Name="NavLab"
						Padding="10"
						StrokeShape="RoundRectangle 12"
						BackgroundColor="#111827">

					<HorizontalStackLayout Spacing="12">
						<Label Text="science"
							   FontFamily="MaterialIcons"
							   FontSize="20"
							   TextColor="#2dd4bf"/>
						<Label Text="Lab Results"
							   TextColor="#e5e7eb"/>
					</HorizontalStackLayout>

					<Border.GestureRecognizers>
						<TapGestureRecognizer Tapped="OnLabTapped"/>
						<PointerGestureRecognizer
							PointerEntered="OnNavPointerEntered"
							PointerExited="OnNavPointerExited"/>
					</Border.GestureRecognizers>
				</Border>


                <!-- AI INSIGHTS -->
                <Border x:Name="NavAI"
        Padding="10"
        StrokeShape="RoundRectangle 12"
        BackgroundColor="Transparent">

                    <HorizontalStackLayout Spacing="12">
                        <Label Text="psychology"
               FontFamily="MaterialIcons"
               FontSize="20"
               TextColor="#9ca3af"/>
                        <Label Text="AI Insights"
               TextColor="#9ca3af"/>
                    </HorizontalStackLayout>

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnAITapped"/>
                        <PointerGestureRecognizer
            PointerEntered="OnNavPointerEntered"
            PointerExited="OnNavPointerExited"/>
                    </Border.GestureRecognizers>
                </Border>

                <!-- APPOINTMENTS -->
				<Border x:Name="NavAppointments"
                Padding="10"
                StrokeShape="RoundRectangle 12"
                BackgroundColor="Transparent">

					<HorizontalStackLayout Spacing="12">
						<Label Text="event"
                       FontFamily="MaterialIcons"
                       FontSize="20"
                       TextColor="#9ca3af"/>
						<Label Text="Appointments"
                       TextColor="#9ca3af"/>
					</HorizontalStackLayout>

					<Border.GestureRecognizers>
						<TapGestureRecognizer Tapped="OnAppointmentsTapped"/>
						<PointerGestureRecognizer
                    PointerEntered="OnNavPointerEntered"
                    PointerExited="OnNavPointerExited"/>
					</Border.GestureRecognizers>
				</Border>
			</VerticalStackLayout>

			<Border Grid.Row="2"
                x:Name="ProfileButton"
                BackgroundColor="#111827"
                Padding="14"
                Stroke="#1f2937"
                StrokeShape="RoundRectangle 14">

				<Border.GestureRecognizers>
					<TapGestureRecognizer Tapped="OnProfileTapped"/>
				</Border.GestureRecognizers>

				<VerticalStackLayout>
					<Label x:Name="DoctorNameLabel"
                        Text="doctor@test.com"
                        FontAttributes="Bold"
                        TextColor="#e5e7eb"/>
					<Label x:Name="DoctorSpecializationLabel"
                            Text="Neurologist"
                            FontSize="11"
                            TextColor="#9ca3af"/>
				</VerticalStackLayout>
			</Border>

			<!-- PROFILE MENU (INSIDE SIDEBAR) -->
			<Border x:Name="ProfileMenu"
					Grid.Row="2"
					IsVisible="False"
					BackgroundColor="#0f172a"
					Stroke="#1f2937"
					StrokeShape="RoundRectangle 16"
					Padding="12"
					Margin="3,64,3,0"
					Opacity="0"
					Scale="0.96"
					ZIndex="10">

				<VerticalStackLayout Spacing="10">

					<!-- SETTINGS -->
					<Border Padding="8" StrokeShape="RoundRectangle 10">
						<HorizontalStackLayout Spacing="12">
							<Label Text="settings"
								   FontFamily="MaterialIcons"
								   FontSize="18"
								   TextColor="#94a3b8"/>
							<Label Text="Settings"
								   FontSize="13"
								   TextColor="#e5e7eb"/>
						</HorizontalStackLayout>
					</Border>

					<!-- PERSONALIZATION -->
					<Border Padding="8" StrokeShape="RoundRectangle 10">
						<HorizontalStackLayout Spacing="12">
							<Label Text="palette"
								   FontFamily="MaterialIcons"
								   FontSize="18"
								   TextColor="#94a3b8"/>
							<Label Text="Personalization"
								   FontSize="13"
								   TextColor="#e5e7eb"/>
						</HorizontalStackLayout>
					</Border>

					<!-- HELP -->
					<Border Padding="8" StrokeShape="RoundRectangle 10">
						<HorizontalStackLayout Spacing="12">
							<Label Text="help_outline"
								   FontFamily="MaterialIcons"
								   FontSize="18"
								   TextColor="#94a3b8"/>
							<Label Text="Help"
								   FontSize="13"
								   TextColor="#e5e7eb"/>
						</HorizontalStackLayout>
					</Border>

					<BoxView HeightRequest="1"
							 Margin="4,6"
							 BackgroundColor="#1e293b"/>

					<!-- LOGOUT -->
					<Border Padding="8"
							StrokeShape="RoundRectangle 10">
						<Border.GestureRecognizers>
							<TapGestureRecognizer Tapped="OnLogoutClicked"/>
						</Border.GestureRecognizers>

						<HorizontalStackLayout Spacing="12">
							<Label Text="logout"
								   FontFamily="MaterialIcons"
								   FontSize="18"
								   TextColor="#f87171"/>
							<Label Text="Logout"
								   FontSize="13"
								   TextColor="#f87171"/>
						</HorizontalStackLayout>
					</Border>

				</VerticalStackLayout>
			</Border>


		</Grid>

        <!-- ================= MAIN ================= -->
        <Grid Grid.Column="1">
            <ScrollView>
                <VerticalStackLayout Padding="32" Spacing="20" VerticalOptions="Start">
                    <VerticalStackLayout Spacing="6">
                        <Label
                            FontAttributes="Bold"
                            FontSize="26"
                            Text="Lab Results"
                            TextColor="#e5e7eb"/>
                        <Label
                            FontSize="13"
                            Text="Patient laboratory reports and diagnostics"
                            TextColor="#9ca3af"/>
                    </VerticalStackLayout>

                    <Label
                        FontSize="14"
                        IsVisible="{Binding LoadFailed}"
                        Text="{Binding FailedToLoadMessage}"
                        TextColor="#f87171"/>

                    <RefreshView x:Name="LabRefreshView" Refreshing="OnRefreshing">
                        <VerticalStackLayout Spacing="20" VerticalOptions="Start">
                        <Grid
                            ColumnDefinitions="280,*"
                            ColumnSpacing="24"
                            RowDefinitions="Auto">
                            <VerticalStackLayout Spacing="10" VerticalOptions="Start">
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="14"
                                    Text="{Binding ResultsHeader}"
                                    TextColor="#94a3b8"/>
                                <CollectionView
                                    ItemsSource="{Binding Results}"
                                    SelectedItem="{Binding SelectedResult, Mode=TwoWay}"
                                    SelectionMode="Single"
                                    VerticalOptions="Start">
                                    <CollectionView.EmptyView>
                                        <Label
                                            Margin="0,8,0,0"
                                            FontSize="13"
                                            Text="No data"
                                            TextColor="#64748b"/>
                                    </CollectionView.EmptyView>
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate x:DataType="docvm:LabResultsListRowViewModel">
                                            <Border
                                                Margin="0,0,0,8"
                                                Padding="12"
                                                BackgroundColor="#111827"
                                                Stroke="#1e293b"
                                                StrokeShape="RoundRectangle 12">
                                                <VerticalStackLayout Spacing="4">
                                                    <Label
                                                        FontAttributes="Bold"
                                                        FontSize="14"
                                                        Text="{Binding FileName}"
                                                        TextColor="#e5e7eb"/>
                                                    <Label
                                                        FontSize="12"
                                                        Text="{Binding PatientDisplay}"
                                                        TextColor="#9ca3af"/>
                                                    <Label
                                                        FontSize="11"
                                                        Text="{Binding UploadedDisplay}"
                                                        TextColor="#64748b"/>
                                                </VerticalStackLayout>
                                            </Border>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="1" Spacing="12" VerticalOptions="Start">
                                <Label
                                    FontSize="14"
                                    IsVisible="{Binding ShowSelectPrompt}"
                                    Text="{Binding SelectPromptMessage}"
                                    TextColor="#64748b"/>

                                <Grid
                                    IsVisible="{Binding HasSelectedResult}"
                                    RowDefinitions="Auto,Auto,Auto"
                                    ColumnDefinitions="*"
                                    VerticalOptions="Start">
                                    <VerticalStackLayout
                                        Grid.Row="0"
                                        Spacing="12"
                                        VerticalOptions="Start">
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="15"
                                        Text="{Binding DetailedViewTitle}"
                                        TextColor="#94a3b8"/>
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="17"
                                        Text="{Binding DetailTestName}"
                                        TextColor="#e5e7eb"/>
                                    <Label
                                        FontSize="12"
                                        Text="{Binding DetailTitleLine}"
                                        TextColor="#9ca3af"/>

                                    <ActivityIndicator
                                        HorizontalOptions="Start"
                                        IsRunning="{Binding IsLoadingDetail}"
                                        IsVisible="{Binding IsLoadingDetail}"
                                        Color="#2dd4bf"/>

                                    <Label
                                        FontSize="13"
                                        IsVisible="{Binding DetailLoadFailed}"
                                        Text="{Binding DetailErrorMessage}"
                                        TextColor="#f87171"/>

                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="13"
                                        IsVisible="{Binding ShowValuesSection}"
                                        Text="{Binding LaboratoryValuesHeader}"
                                        TextColor="#94a3b8"/>

                                    <CollectionView
                                        IsVisible="{Binding ShowValuesSection}"
                                        ItemsSource="{Binding DetailValues}"
                                        VerticalOptions="Start">
                                        <CollectionView.ItemTemplate>
                                            <DataTemplate x:DataType="docvm:LabResultValueRowViewModel">
                                                <Border
                                                    Margin="0,0,0,8"
                                                    Padding="0"
                                                    BackgroundColor="#111827"
                                                    Stroke="#1e293b"
                                                    StrokeShape="RoundRectangle 12">
                                                    <Grid
                                                        Padding="12"
                                                        ColumnDefinitions="*,Auto,Auto"
                                                        ColumnSpacing="16"
                                                        RowDefinitions="Auto">
                                                        <Label
                                                            Grid.Column="0"
                                                            FontAttributes="Bold"
                                                            FontSize="13"
                                                            LineBreakMode="TailTruncation"
                                                            Text="{Binding Name}"
                                                            TextColor="#e5e7eb"
                                                            VerticalOptions="Center"/>
                                                        <Label
                                                            Grid.Column="1"
                                                            FontSize="13"
                                                            HorizontalTextAlignment="End"
                                                            Text="{Binding ValueFormatted}"
                                                            TextColor="#cbd5e1"
                                                            VerticalOptions="Center"/>
                                                        <Label
                                                            Grid.Column="2"
                                                            FontAttributes="Bold"
                                                            FontSize="12"
                                                            HorizontalTextAlignment="End"
                                                            MinimumWidthRequest="88"
                                                            Text="{Binding StatusWithGlyph}"
                                                            TextColor="{Binding StatusColor}"
                                                            VerticalOptions="Center"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </CollectionView.ItemTemplate>
                                    </CollectionView>

                                    <Label
                                        FontSize="13"
                                        IsVisible="{Binding ShowNoValuesMessage}"
                                        LineBreakMode="WordWrap"
                                        Text="{Binding NoStructuredValuesMessage}"
                                        TextColor="#64748b"/>

                                    </VerticalStackLayout>

                                    <VerticalStackLayout
                                        Grid.Row="1"
                                        Spacing="0"
                                        VerticalOptions="Start">
                                        <HorizontalStackLayout
                                            Spacing="10"
                                            Margin="0,10,0,0">
                                            <Border
                                                Padding="10,8"
                                                BackgroundColor="#1e293b"
                                                StrokeShape="RoundRectangle 10">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnViewSelectedClicked"/>
                                                </Border.GestureRecognizers>
                                                <HorizontalStackLayout Spacing="8">
                                                    <Label
                                                        FontFamily="MaterialIcons"
                                                        FontSize="18"
                                                        Text="visibility"
                                                        TextColor="#38bdf8"
                                                        VerticalOptions="Center"/>
                                                    <Label
                                                        FontSize="13"
                                                        Text="{Binding LabViewLabel}"
                                                        TextColor="#e5e7eb"
                                                        VerticalOptions="Center"/>
                                                </HorizontalStackLayout>
                                            </Border>
                                            <Border
                                                Padding="10,8"
                                                BackgroundColor="#1e293b"
                                                StrokeShape="RoundRectangle 10">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnDownloadSelectedClicked"/>
                                                </Border.GestureRecognizers>
                                                <HorizontalStackLayout Spacing="8">
                                                    <Label
                                                        FontFamily="MaterialIcons"
                                                        FontSize="18"
                                                        Text="download"
                                                        TextColor="#38bdf8"
                                                        VerticalOptions="Center"/>
                                                    <Label
                                                        FontSize="13"
                                                        Text="{Binding LabDownloadLabel}"
                                                        TextColor="#e5e7eb"
                                                        VerticalOptions="Center"/>
                                                </HorizontalStackLayout>
                                            </Border>
                                            <Border
                                                Padding="10,8"
                                                BackgroundColor="#1e293b"
                                                StrokeShape="RoundRectangle 10">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnAnalyzeSelectedClicked"/>
                                                </Border.GestureRecognizers>
                                                <HorizontalStackLayout Spacing="8">
                                                    <Label
                                                        FontFamily="MaterialIcons"
                                                        FontSize="18"
                                                        Text="android"
                                                        TextColor="#38bdf8"
                                                        VerticalOptions="Center"/>
                                                    <Label
                                                        FontSize="13"
                                                        Text="{Binding LabAnalyzeLabel}"
                                                        TextColor="#e5e7eb"
                                                        VerticalOptions="Center"/>
                                                </HorizontalStackLayout>
                                            </Border>
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>

                                    <Border
                                        Grid.Row="2"
                                        Margin="0,20,0,0"
                                        Padding="20"
                                        BackgroundColor="#0f172a"
                                        Stroke="#22d3ee"
                                        StrokeShape="RoundRectangle 20">
                                        <VerticalStackLayout Spacing="12">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <HorizontalStackLayout Spacing="10">
                                                    <Label
                                                        FontFamily="MaterialIcons"
                                                        FontSize="22"
                                                        Text="auto_awesome"
                                                        TextColor="#22d3ee"
                                                        VerticalOptions="Center"/>
                                                    <Label
                                                        FontAttributes="Bold"
                                                        FontSize="16"
                                                        Text="{Binding AiInsightsTitle}"
                                                        TextColor="#22d3ee"
                                                        VerticalOptions="Center"/>
                                                </HorizontalStackLayout>
                                                <Border
                                                    Grid.Column="1"
                                                    Padding="10,6"
                                                    BackgroundColor="#111827"
                                                    StrokeShape="RoundRectangle 10">
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="OnDismissAiClicked"/>
                                                    </Border.GestureRecognizers>
                                                    <Label
                                                        FontSize="12"
                                                        Text="{Binding AiCloseLabel}"
                                                        TextColor="#94a3b8"/>
                                                </Border>
                                            </Grid>

                                            <ActivityIndicator
                                                IsRunning="{Binding IsAnalysisLoading}"
                                                IsVisible="{Binding IsAnalysisLoading}"
                                                Color="#22d3ee"/>

                                            <Label
                                                FontSize="12"
                                                IsVisible="{Binding IsAnalysisLoading}"
                                                LineBreakMode="WordWrap"
                                                Text="{Binding AnalysisLoadingMessage}"
                                                TextColor="#64748b"/>

                                            <Label
                                                FontSize="13"
                                                IsVisible="{Binding ShowAnalysisError}"
                                                Text="{Binding AnalysisErrorMessage}"
                                                TextColor="#f87171"/>

                                            <Label
                                                FontSize="13"
                                                IsVisible="{Binding ShowAnalysisHint}"
                                                Text="{Binding AnalysisHintText}"
                                                TextColor="#64748b"/>

                                            <Label
                                                FontSize="13"
                                                IsVisible="{Binding ShowNoAiAnalysisMessage}"
                                                Text="{Binding NoAiAnalysisText}"
                                                TextColor="#64748b"/>

                                            <Label
                                                FontAttributes="Bold"
                                                FontSize="12"
                                                IsVisible="{Binding ShowAiContent}"
                                                Text="{Binding SummarySectionTitle}"
                                                TextColor="#94a3b8"/>
                                            <Label
                                                FontSize="14"
                                                IsVisible="{Binding ShowAiContent}"
                                                LineBreakMode="WordWrap"
                                                Text="{Binding AnalysisSummaryText}"
                                                TextColor="#e5e7eb"/>

                                            <Border
                                                Padding="14"
                                                BackgroundColor="#020617"
                                                IsVisible="{Binding ShowAnalysisPriorityBlock}"
                                                Stroke="#f59e0b"
                                                StrokeShape="RoundRectangle 14">
                                                <VerticalStackLayout Spacing="6">
                                                    <Label
                                                        FontAttributes="Bold"
                                                        FontSize="10"
                                                        Text="{Binding PrioritySectionTitle}"
                                                        TextColor="#f59e0b"/>
                                                    <Label
                                                        FontSize="12"
                                                        LineBreakMode="WordWrap"
                                                        Text="{Binding AnalysisPriorityText}"
                                                        TextColor="#f59e0b"/>
                                                </VerticalStackLayout>
                                            </Border>

                                            <Label
                                                FontAttributes="Bold"
                                                FontSize="12"
                                                IsVisible="{Binding ShowFindingsSection}"
                                                Text="{Binding FindingsSectionTitle}"
                                                TextColor="#94a3b8"/>
                                            <Label
                                                FontSize="12"
                                                IsVisible="{Binding ShowFindingsSection}"
                                                LineBreakMode="WordWrap"
                                                Text="{Binding FindingsDisplay}"
                                                TextColor="#cbd5e1"/>

                                            <Label
                                                FontAttributes="Bold"
                                                FontSize="12"
                                                IsVisible="{Binding ShowAiContent}"
                                                Text="{Binding RecommendationsSectionTitle}"
                                                TextColor="#94a3b8"/>
                                            <Label
                                                FontSize="12"
                                                IsVisible="{Binding ShowAiContent}"
                                                LineBreakMode="WordWrap"
                                                Text="{Binding RecommendationsDisplay}"
                                                TextColor="#9ca3af"/>

                                            <BoxView
                                                HeightRequest="1"
                                                IsVisible="{Binding ShowAiLaboratoryInterpretationSection}"
                                                Color="#1e293b"
                                                Margin="0,8,0,4"/>

                                            <VerticalStackLayout
                                                IsVisible="{Binding ShowAiLaboratoryInterpretationSection}"
                                                Spacing="8">
                                                <Label
                                                    FontAttributes="Bold"
                                                    FontSize="12"
                                                    Text="{Binding AiLaboratoryInterpretationTitle}"
                                                    TextColor="#22d3ee"/>
                                                <Label
                                                    FontSize="11"
                                                    LineBreakMode="WordWrap"
                                                    Text="{Binding AiLaboratoryInterpretationDisclaimer}"
                                                    TextColor="#64748b"/>
                                                <Label
                                                    FontSize="11"
                                                    IsVisible="{Binding ShowLabInterpretationFallbackHint}"
                                                    LineBreakMode="WordWrap"
                                                    Text="{Binding LabInterpretationFallbackHintText}"
                                                    TextColor="#64748b"/>
                                                <Label
                                                    FontSize="13"
                                                    LineBreakMode="WordWrap"
                                                    Text="{Binding AiLaboratoryInterpretationText}"
                                                    TextColor="#e5e7eb"/>
                                            </VerticalStackLayout>
                                        </VerticalStackLayout>
                                    </Border>
                                </Grid>
                            </VerticalStackLayout>
                        </Grid>
                        </VerticalStackLayout>
                    </RefreshView>
                </VerticalStackLayout>
            </ScrollView>

            <ActivityIndicator
                HorizontalOptions="Center"
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                Scale="1.2"
                VerticalOptions="Center"
                Color="#2dd4bf"/>
        </Grid>


	</Grid>
</ContentPage>
