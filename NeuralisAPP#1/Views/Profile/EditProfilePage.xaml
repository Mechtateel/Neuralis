<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="NeuralisAPP_1.Views.Profile.EditProfilePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="{StaticResource BgPrimary}"
    NavigationPage.HasNavigationBar="False"
    Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <Style x:Key="FieldBorderStyle" TargetType="Border">
            <Setter Property="BackgroundColor" Value="#102F34"/>
            <Setter Property="Stroke" Value="#1F4F55"/>
            <Setter Property="StrokeThickness" Value="1"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="StrokeShape" Value="RoundRectangle 12"/>
        </Style>
        <Style x:Key="FieldLabelStyle" TargetType="Label">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontAttributes" Value="Bold"/>
            <Setter Property="CharacterSpacing" Value="1"/>
            <Setter Property="TextColor" Value="{StaticResource Muted}"/>
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">
        <!-- Top bar -->
        <Grid Grid.Row="0" Padding="24,20,24,0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
            <Border
                Grid.Column="0"
                Padding="6,4"
                StrokeShape="RoundRectangle 10"
                BackgroundColor="Transparent">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCancelTapped"/>
                </Border.GestureRecognizers>
                <HorizontalStackLayout Spacing="6">
                    <Label
                        Text="arrow_back"
                        FontFamily="MaterialIcons"
                        FontSize="20"
                        TextColor="{StaticResource TextSecondary}"
                        VerticalOptions="Center"/>
                    <Label
                        Text="Cancel"
                        FontSize="13"
                        TextColor="{StaticResource TextSecondary}"
                        VerticalOptions="Center"/>
                </HorizontalStackLayout>
            </Border>
            <Label
                Grid.Column="1"
                Text="Edit profile"
                FontSize="18"
                FontAttributes="Bold"
                TextColor="{StaticResource TextPrimary}"
                HorizontalOptions="Center"
                VerticalOptions="Center"/>
            <Button
                x:Name="SaveButton"
                Grid.Column="2"
                Text="Save"
                MinimumWidthRequest="100"
                Style="{StaticResource PrimaryButton}"
                Clicked="OnSaveClicked"/>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="24" Spacing="18" MaximumWidthRequest="780" HorizontalOptions="Center">

                <!-- Identity (read-only) -->
                <Border Padding="20" Style="{StaticResource HoverCardStyle}">
                    <VerticalStackLayout Spacing="10">
                        <Label Style="{StaticResource SectionLabel}" Text="Identity"/>
                        <Label
                            FontSize="12"
                            TextColor="{StaticResource Muted}"
                            LineBreakMode="WordWrap"
                            Text="Name and email are managed by your account. Contact an administrator to request a change."/>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="14" RowSpacing="10">
                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                <Label Style="{StaticResource FieldLabelStyle}" Text="NAME"/>
                                <Label
                                    x:Name="NameReadonlyLabel"
                                    FontSize="14"
                                    TextColor="{StaticResource TextPrimary}"
                                    LineBreakMode="WordWrap"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Style="{StaticResource FieldLabelStyle}" Text="EMAIL"/>
                                <Label
                                    x:Name="EmailReadonlyLabel"
                                    FontSize="14"
                                    TextColor="{StaticResource TextPrimary}"
                                    LineBreakMode="WordWrap"/>
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Editable -->
                <Border Padding="20" Style="{StaticResource HoverCardStyle}">
                    <VerticalStackLayout Spacing="14">
                        <Label Style="{StaticResource SectionLabel}" Text="Contact details"/>

                        <VerticalStackLayout Spacing="6">
                            <Label Style="{StaticResource FieldLabelStyle}" Text="PHONE"/>
                            <Border Style="{StaticResource FieldBorderStyle}">
                                <Entry
                                    x:Name="PhoneEntry"
                                    Placeholder="+7 707 000 0000"
                                    PlaceholderColor="{StaticResource Muted}"
                                    TextColor="{StaticResource TextPrimary}"
                                    BackgroundColor="Transparent"
                                    Keyboard="Telephone"
                                    MaxLength="32"/>
                            </Border>
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                            <VerticalStackLayout Grid.Column="0" Spacing="6">
                                <Label Style="{StaticResource FieldLabelStyle}" Text="DATE OF BIRTH"/>
                                <Border Style="{StaticResource FieldBorderStyle}">
                                    <DatePicker
                                        x:Name="DobPicker"
                                        TextColor="{StaticResource TextPrimary}"
                                        BackgroundColor="Transparent"
                                        Format="yyyy-MM-dd"/>
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="6">
                                <Label Style="{StaticResource FieldLabelStyle}" Text="GENDER"/>
                                <Border Style="{StaticResource FieldBorderStyle}">
                                    <Picker
                                        x:Name="GenderPicker"
                                        TextColor="{StaticResource TextPrimary}"
                                        BackgroundColor="Transparent"
                                        TitleColor="{StaticResource Muted}"
                                        Title="Select">
                                        <Picker.Items>
                                            <x:String>Prefer not to say</x:String>
                                            <x:String>Female</x:String>
                                            <x:String>Male</x:String>
                                            <x:String>Other</x:String>
                                        </Picker.Items>
                                    </Picker>
                                </Border>
                            </VerticalStackLayout>
                        </Grid>

                        <VerticalStackLayout Spacing="6">
                            <Label Style="{StaticResource FieldLabelStyle}" Text="EMERGENCY CONTACT"/>
                            <Border Style="{StaticResource FieldBorderStyle}">
                                <Entry
                                    x:Name="EmergencyEntry"
                                    Placeholder="Name and phone"
                                    PlaceholderColor="{StaticResource Muted}"
                                    TextColor="{StaticResource TextPrimary}"
                                    BackgroundColor="Transparent"
                                    MaxLength="120"/>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6">
                            <Label Style="{StaticResource FieldLabelStyle}" Text="BIO / STATUS"/>
                            <Border Style="{StaticResource FieldBorderStyle}">
                                <Editor
                                    x:Name="BioEditor"
                                    Placeholder="Short note (optional)"
                                    PlaceholderColor="{StaticResource Muted}"
                                    TextColor="{StaticResource TextPrimary}"
                                    BackgroundColor="Transparent"
                                    AutoSize="TextChanges"
                                    MaxLength="240"
                                    MinimumHeightRequest="80"/>
                            </Border>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Doctor-only block -->
                <Border
                    x:Name="DoctorOnlyCard"
                    IsVisible="False"
                    Padding="20"
                    Style="{StaticResource HoverCardStyle}">
                    <VerticalStackLayout Spacing="14">
                        <Label Style="{StaticResource SectionLabel}" Text="Practice"/>

                        <VerticalStackLayout Spacing="6">
                            <Label Style="{StaticResource FieldLabelStyle}" Text="CLINIC / FACILITY"/>
                            <Border Style="{StaticResource FieldBorderStyle}">
                                <Entry
                                    x:Name="ClinicEntry"
                                    Placeholder="Clinic, facility or department"
                                    PlaceholderColor="{StaticResource Muted}"
                                    TextColor="{StaticResource TextPrimary}"
                                    BackgroundColor="Transparent"
                                    MaxLength="160"/>
                            </Border>
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                <Label
                                    FontSize="13"
                                    Text="Accepting bookings"
                                    TextColor="{StaticResource TextPrimary}"/>
                                <Label
                                    FontSize="11"
                                    Text="Disable to hide your slots from new bookings."
                                    TextColor="{StaticResource Muted}"
                                    LineBreakMode="WordWrap"/>
                            </VerticalStackLayout>
                            <Switch
                                x:Name="AvailableSwitch"
                                Grid.Column="1"
                                OnColor="{StaticResource Accent}"
                                ThumbColor="{StaticResource TextPrimary}"
                                VerticalOptions="Center"/>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Label
                    x:Name="ErrorLabel"
                    IsVisible="False"
                    FontSize="13"
                    LineBreakMode="WordWrap"
                    TextColor="#F87171"/>

                <ActivityIndicator
                    x:Name="LoadingIndicator"
                    IsRunning="False"
                    IsVisible="False"
                    Color="{StaticResource Accent}"
                    HorizontalOptions="Center"/>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
