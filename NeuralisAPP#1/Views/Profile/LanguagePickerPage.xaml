<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="NeuralisAPP_1.Views.Profile.LanguagePickerPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="{StaticResource BgPrimary}"
    NavigationPage.HasNavigationBar="False"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">
        <Grid Grid.Row="0" Padding="24,20,24,0" ColumnDefinitions="Auto,*">
            <Border
                Grid.Column="0"
                Padding="6,4"
                StrokeShape="RoundRectangle 10"
                BackgroundColor="Transparent">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped"/>
                </Border.GestureRecognizers>
                <HorizontalStackLayout Spacing="6">
                    <Label Text="arrow_back" FontFamily="MaterialIcons" FontSize="20" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center"/>
                    <Label Text="Back" FontSize="13" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center"/>
                </HorizontalStackLayout>
            </Border>
            <Label
                Grid.Column="1"
                Text="Language"
                FontSize="18"
                FontAttributes="Bold"
                TextColor="{StaticResource TextPrimary}"
                HorizontalOptions="Center"
                VerticalOptions="Center"/>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="24" Spacing="18" MaximumWidthRequest="560" HorizontalOptions="Center">
                <Border Padding="22" Style="{StaticResource HoverCardStyle}">
                    <VerticalStackLayout Spacing="6">
                        <Label Style="{StaticResource SectionLabel}" Text="In-app language"/>
                        <Label
                            FontSize="12"
                            TextColor="{StaticResource Muted}"
                            LineBreakMode="WordWrap"
                            Text="Selected language is applied across screens that use the localization service. Changes are saved instantly."/>
                        <BoxView HeightRequest="1" Color="#143A42" Margin="0,8"/>

                        <Border x:Name="EnRow" Padding="14" StrokeShape="RoundRectangle 12" BackgroundColor="#0B252B">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnEnTapped"/>
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                    <Label Text="English" FontSize="14" TextColor="{StaticResource TextPrimary}"/>
                                    <Label Text="EN" FontSize="11" TextColor="{StaticResource Muted}"/>
                                </VerticalStackLayout>
                                <Label
                                    x:Name="EnCheck"
                                    Grid.Column="1"
                                    Text="check_circle"
                                    FontFamily="MaterialIcons"
                                    FontSize="22"
                                    TextColor="{StaticResource Accent}"
                                    VerticalOptions="Center"
                                    IsVisible="False"/>
                            </Grid>
                        </Border>

                        <Border x:Name="RuRow" Padding="14" StrokeShape="RoundRectangle 12" BackgroundColor="#0B252B">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnRuTapped"/>
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                    <Label Text="Russian / Русский" FontSize="14" TextColor="{StaticResource TextPrimary}"/>
                                    <Label Text="RU" FontSize="11" TextColor="{StaticResource Muted}"/>
                                </VerticalStackLayout>
                                <Label
                                    x:Name="RuCheck"
                                    Grid.Column="1"
                                    Text="check_circle"
                                    FontFamily="MaterialIcons"
                                    FontSize="22"
                                    TextColor="{StaticResource Accent}"
                                    VerticalOptions="Center"
                                    IsVisible="False"/>
                            </Grid>
                        </Border>

                        <Border x:Name="KzRow" Padding="14" StrokeShape="RoundRectangle 12" BackgroundColor="#0B252B">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnKzTapped"/>
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                    <Label Text="Kazakh / Қазақша" FontSize="14" TextColor="{StaticResource TextPrimary}"/>
                                    <Label Text="KZ" FontSize="11" TextColor="{StaticResource Muted}"/>
                                </VerticalStackLayout>
                                <Label
                                    x:Name="KzCheck"
                                    Grid.Column="1"
                                    Text="check_circle"
                                    FontFamily="MaterialIcons"
                                    FontSize="22"
                                    TextColor="{StaticResource Accent}"
                                    VerticalOptions="Center"
                                    IsVisible="False"/>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
