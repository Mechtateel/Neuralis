<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="NeuralisAPP_1.Views.Profile.PrivacySettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="{StaticResource BgPrimary}"
    NavigationPage.HasNavigationBar="False"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">
        <Grid Grid.Row="0" Padding="24,20,24,0" ColumnDefinitions="Auto,*">
            <Border
                Grid.Column="0"
                Padding="6,4"
                StrokeShape="RoundRectangle 10"
                BackgroundColor="Transparent">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped"/>
                </Border.GestureRecognizers>
                <HorizontalStackLayout Spacing="6">
                    <Label Text="arrow_back" FontFamily="MaterialIcons" FontSize="20" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center"/>
                    <Label Text="Back" FontSize="13" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center"/>
                </HorizontalStackLayout>
            </Border>
            <Label
                Grid.Column="1"
                Text="Privacy settings"
                FontSize="18"
                FontAttributes="Bold"
                TextColor="{StaticResource TextPrimary}"
                HorizontalOptions="Center"
                VerticalOptions="Center"/>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="24" Spacing="18" MaximumWidthRequest="680" HorizontalOptions="Center">

                <Border Padding="22" Style="{StaticResource HoverCardStyle}">
                    <VerticalStackLayout Spacing="8">
                        <Label Style="{StaticResource SectionLabel}" Text="Privacy controls"/>
                        <Label FontSize="12" TextColor="{StaticResource Muted}" Text="Each preference is saved as soon as you change it."/>
                        <BoxView HeightRequest="1" Color="#143A42" Margin="0,8"/>

                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" RowSpacing="14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Label Grid.Row="0" Grid.Column="0" Text="visibility" FontFamily="MaterialIcons" FontSize="20" TextColor="{StaticResource Accent}" VerticalOptions="Center"/>
                            <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Profile visibility" FontSize="14" TextColor="{StaticResource TextPrimary}"/>
                                <Label Text="Allow doctors/admins on this platform to view your profile details." FontSize="11" TextColor="{StaticResource Muted}" LineBreakMode="WordWrap"/>
                            </VerticalStackLayout>
                            <Switch Grid.Row="0" Grid.Column="2" x:Name="ProfileVisibleSwitch" OnColor="{StaticResource Accent}" Toggled="OnProfileVisibleToggled"/>

                            <Label Grid.Row="1" Grid.Column="0" Text="analytics" FontFamily="MaterialIcons" FontSize="20" TextColor="{StaticResource Accent}" VerticalOptions="Center"/>
                            <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Share analytics" FontSize="14" TextColor="{StaticResource TextPrimary}"/>
                                <Label Text="Allow anonymous usage analytics to help improve Neuralis." FontSize="11" TextColor="{StaticResource Muted}" LineBreakMode="WordWrap"/>
                            </VerticalStackLayout>
                            <Switch Grid.Row="1" Grid.Column="2" x:Name="ShareAnalyticsSwitch" OnColor="{StaticResource Accent}" Toggled="OnShareAnalyticsToggled"/>

                            <Label Grid.Row="2" Grid.Column="0" Text="history" FontFamily="MaterialIcons" FontSize="20" TextColor="{StaticResource Accent}" VerticalOptions="Center"/>
                            <VerticalStackLayout Grid.Row="2" Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Save AI history" FontSize="14" TextColor="{StaticResource TextPrimary}"/>
                                <Label Text="Keep your AI analysis history on this device for quick recall." FontSize="11" TextColor="{StaticResource Muted}" LineBreakMode="WordWrap"/>
                            </VerticalStackLayout>
                            <Switch Grid.Row="2" Grid.Column="2" x:Name="SaveAiHistorySwitch" OnColor="{StaticResource Accent}" Toggled="OnSaveAiHistoryToggled"/>

                            <Label Grid.Row="3" Grid.Column="0" Text="trending_up" FontFamily="MaterialIcons" FontSize="20" TextColor="{StaticResource Accent}" VerticalOptions="Center"/>
                            <VerticalStackLayout Grid.Row="3" Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Activity tracking" FontSize="14" TextColor="{StaticResource TextPrimary}"/>
                                <Label Text="Track usage to power your personal activity overview." FontSize="11" TextColor="{StaticResource Muted}" LineBreakMode="WordWrap"/>
                            </VerticalStackLayout>
                            <Switch Grid.Row="3" Grid.Column="2" x:Name="ActivityTrackingSwitch" OnColor="{StaticResource Accent}" Toggled="OnActivityTrackingToggled"/>
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
