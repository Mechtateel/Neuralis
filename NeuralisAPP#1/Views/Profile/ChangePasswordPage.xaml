<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="NeuralisAPP_1.Views.Profile.ChangePasswordPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="{StaticResource BgPrimary}"
    NavigationPage.HasNavigationBar="False"
    Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <Style x:Key="FieldBorderStyle" TargetType="Border">
            <Setter Property="BackgroundColor" Value="#102F34"/>
            <Setter Property="Stroke" Value="#1F4F55"/>
            <Setter Property="StrokeThickness" Value="1"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="StrokeShape" Value="RoundRectangle 12"/>
        </Style>
        <Style x:Key="FieldLabelStyle" TargetType="Label">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontAttributes" Value="Bold"/>
            <Setter Property="CharacterSpacing" Value="1"/>
            <Setter Property="TextColor" Value="{StaticResource Muted}"/>
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">
        <Grid Grid.Row="0" Padding="24,20,24,0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
            <Border
                Grid.Column="0"
                Padding="6,4"
                StrokeShape="RoundRectangle 10"
                BackgroundColor="Transparent">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCancelTapped"/>
                </Border.GestureRecognizers>
                <HorizontalStackLayout Spacing="6">
                    <Label
                        Text="arrow_back"
                        FontFamily="MaterialIcons"
                        FontSize="20"
                        TextColor="{StaticResource TextSecondary}"
                        VerticalOptions="Center"/>
                    <Label
                        Text="Back"
                        FontSize="13"
                        TextColor="{StaticResource TextSecondary}"
                        VerticalOptions="Center"/>
                </HorizontalStackLayout>
            </Border>
            <Label
                Grid.Column="1"
                Text="Change password"
                FontSize="18"
                FontAttributes="Bold"
                TextColor="{StaticResource TextPrimary}"
                HorizontalOptions="Center"
                VerticalOptions="Center"/>
            <Button
                x:Name="SubmitButton"
                Grid.Column="2"
                Text="Submit"
                MinimumWidthRequest="110"
                Style="{StaticResource PrimaryButton}"
                Clicked="OnSubmitClicked"/>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="24" Spacing="18" MaximumWidthRequest="560" HorizontalOptions="Center">

                <Border Padding="20" Style="{StaticResource HoverCardStyle}">
                    <VerticalStackLayout Spacing="14">
                        <Label Style="{StaticResource SectionLabel}" Text="Password update"/>
                        <Label
                            FontSize="12"
                            LineBreakMode="WordWrap"
                            TextColor="{StaticResource Muted}"
                            Text="Use a strong password — at least 8 characters with a number and a letter."/>

                        <VerticalStackLayout Spacing="6">
                            <Label Style="{StaticResource FieldLabelStyle}" Text="CURRENT PASSWORD"/>
                            <Border Style="{StaticResource FieldBorderStyle}">
                                <Entry
                                    x:Name="OldPasswordEntry"
                                    IsPassword="True"
                                    Placeholder="••••••••"
                                    PlaceholderColor="{StaticResource Muted}"
                                    TextColor="{StaticResource TextPrimary}"
                                    BackgroundColor="Transparent"/>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6">
                            <Label Style="{StaticResource FieldLabelStyle}" Text="NEW PASSWORD"/>
                            <Border Style="{StaticResource FieldBorderStyle}">
                                <Entry
                                    x:Name="NewPasswordEntry"
                                    IsPassword="True"
                                    Placeholder="At least 8 characters"
                                    PlaceholderColor="{StaticResource Muted}"
                                    TextColor="{StaticResource TextPrimary}"
                                    BackgroundColor="Transparent"
                                    TextChanged="OnNewPasswordChanged"/>
                            </Border>
                            <Label
                                x:Name="StrengthLabel"
                                FontSize="11"
                                Text=""
                                TextColor="{StaticResource Muted}"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6">
                            <Label Style="{StaticResource FieldLabelStyle}" Text="CONFIRM NEW PASSWORD"/>
                            <Border Style="{StaticResource FieldBorderStyle}">
                                <Entry
                                    x:Name="ConfirmPasswordEntry"
                                    IsPassword="True"
                                    Placeholder="Repeat new password"
                                    PlaceholderColor="{StaticResource Muted}"
                                    TextColor="{StaticResource TextPrimary}"
                                    BackgroundColor="Transparent"/>
                            </Border>
                        </VerticalStackLayout>

                        <Label
                            x:Name="ErrorLabel"
                            IsVisible="False"
                            FontSize="13"
                            LineBreakMode="WordWrap"
                            TextColor="#F87171"/>

                        <ActivityIndicator
                            x:Name="LoadingIndicator"
                            IsRunning="False"
                            IsVisible="False"
                            Color="{StaticResource Accent}"
                            HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
