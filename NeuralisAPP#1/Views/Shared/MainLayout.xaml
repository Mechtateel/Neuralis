<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="NeuralisAPP_1.Views.Shared.MainLayout"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="RootLayout">

    <Grid RowDefinitions="Auto,*">
        <Grid
            Grid.Row="0"
            Padding="12,10,12,0"
            ColumnDefinitions="Auto,*">
            <Border
                x:Name="HamburgerHost"
                IsVisible="False"
                Padding="0"
                HorizontalOptions="Start"
                VerticalOptions="Center"
                Stroke="#1E4A50"
                BackgroundColor="#0B252B"
                StrokeShape="RoundRectangle 8">
                <Button
                    Text="☰"
                    FontSize="18"
                    Padding="8,4"
                    BackgroundColor="Transparent"
                    TextColor="#D8F5F1"
                    Clicked="OnHamburgerClicked" />
            </Border>
        </Grid>

        <Grid Grid.Row="1">
            <!-- 1) Page content (bottom layer) -->
            <Grid
                x:Name="PageContentHost"
                ZIndex="0"
                Padding="20,16">
                <ContentPresenter x:Name="PageContentPresenter" />
            </Grid>

            <!-- 2) Overlay (middle layer) -->
            <Grid
                x:Name="OverlayLayer"
                ZIndex="1"
                IsVisible="False"
                BackgroundColor="#80000000">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnOverlayTapped" />
                </Grid.GestureRecognizers>
            </Grid>

            <!-- 3) Sidebar (top layer) -->
            <Grid
                x:Name="SidebarLayer"
                ZIndex="2"
                WidthRequest="280"
                HorizontalOptions="Start"
                VerticalOptions="Fill"
                TranslationX="-280">
                <ContentPresenter x:Name="SidebarContentPresenter" />
            </Grid>
        </Grid>
    </Grid>
</ContentView>
