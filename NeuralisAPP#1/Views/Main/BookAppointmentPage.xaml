<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="NeuralisAPP_1.Views.Main.BookAppointmentPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:NeuralisAPP_1.Views.Main.Controls"
    xmlns:shared="clr-namespace:NeuralisAPP_1.Views.Shared"
    BackgroundColor="#071A1F"
    NavigationPage.HasNavigationBar="False"
    Shell.NavBarIsVisible="False">

    <shared:MainLayout x:Name="GlobalLayout">
        <shared:MainLayout.SidebarContent>
            <controls:UserAppSidebarView x:Name="AppSidebar"/>
        </shared:MainLayout.SidebarContent>

        <shared:MainLayout.PageContent>
        <Grid>
            <Image
                Aspect="AspectFill"
                InputTransparent="True"
                Opacity="0.25"
                Source="back_img.png"/>

            <ScrollView>
            <controls:MainContentWrapper>
            <Grid
                x:Name="RootSplit"
                ColumnSpacing="20"
                RowSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="7*"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <VerticalStackLayout
                    x:Name="LeftScroll"
                    Grid.Row="0"
                    Grid.Column="0"
                    Spacing="16">

                        <VerticalStackLayout Spacing="4">
                            <Label
                                Style="{StaticResource TitleLabel}"
                                Text="Book a visit"/>
                            <Label
                                FontSize="13"
                                LineBreakMode="WordWrap"
                                LineHeight="1.3"
                                Text="Search doctors, select one, then choose date and time. Times are sent in UTC."
                                TextColor="{StaticResource TextMuted}"/>
                        </VerticalStackLayout>

                        <!-- Specialization first, then name search -->
                        <Border Style="{StaticResource HoverCardStyle}" Padding="14,12">
                            <VerticalStackLayout Spacing="12">
                                <Label
                                    FontSize="12"
                                    Text="Specialization"
                                    TextColor="{StaticResource TextMuted}"/>
                                <Picker
                                    x:Name="SpecializationPicker"
                                    Title="All specializations"
                                    BackgroundColor="#102F36"
                                    TextColor="White"
                                    SelectedIndexChanged="OnSpecializationChanged"/>
                                <Grid
                                    ColumnSpacing="12"
                                    ColumnDefinitions="Auto,*,Auto"
                                    VerticalOptions="Center">
                                    <Label
                                        Grid.Column="0"
                                        FontFamily="MaterialIcons"
                                        FontSize="22"
                                        Text="search"
                                        TextColor="{StaticResource TextMuted}"
                                        VerticalOptions="Center"/>
                                    <Entry
                                        x:Name="NameFilterEntry"
                                        Grid.Column="1"
                                        BackgroundColor="#102F36"
                                        Placeholder="Search by name or email"
                                        PlaceholderColor="{StaticResource TextMuted}"
                                        TextColor="White"
                                        VerticalOptions="Center"
                                        TextChanged="OnNameFilterChanged"/>
                                    <Button
                                        x:Name="ClearFiltersButton"
                                        Grid.Column="2"
                                        Padding="12,6"
                                        Style="{StaticResource GhostButton}"
                                        Text="Clear"
                                        VerticalOptions="Center"
                                        Clicked="OnClearFiltersClicked"/>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                        <HorizontalStackLayout Spacing="12" VerticalOptions="Start">
                            <ActivityIndicator
                                x:Name="LoadingIndicator"
                                Color="{StaticResource Accent}"
                                IsVisible="False"
                                VerticalOptions="Center"/>
                            <Label
                                x:Name="EmptyDoctorsLabel"
                                FontSize="13"
                                IsVisible="False"
                                LineBreakMode="WordWrap"
                                Text="No doctors match your filters."
                                TextColor="{StaticResource TextMuted}"
                                VerticalOptions="Center"/>
                        </HorizontalStackLayout>

                        <Grid
                            x:Name="DoctorCardsGrid"
                            ColumnSpacing="14"
                            RowSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                        </Grid>
                </VerticalStackLayout>

                <Border
                    x:Name="RightScroll"
                    Grid.Row="0"
                    Grid.Column="1"
                    Style="{StaticResource HoverCardStyle}"
                    Padding="20"
                    VerticalOptions="Start">
                    <VerticalStackLayout Spacing="16">

                            <VerticalStackLayout Spacing="4">
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="16"
                                    Text="Schedule"
                                    TextColor="{StaticResource TextPrimary}"/>
                                <Label
                                    FontSize="12"
                                    LineBreakMode="WordWrap"
                                    Text="Select date and a time slot, then confirm."
                                    TextColor="{StaticResource TextMuted}"/>
                            </VerticalStackLayout>

                            <BoxView
                                HeightRequest="1"
                                Color="#163F46"/>

                            <VerticalStackLayout Spacing="6">
                                <Label
                                    FontSize="12"
                                    Text="Selected doctor"
                                    TextColor="{StaticResource TextMuted}"/>
                                <Label
                                    x:Name="SelectedDoctorNameLabel"
                                    FontAttributes="Bold"
                                    FontSize="15"
                                    LineBreakMode="WordWrap"
                                    Text="None selected"
                                    TextColor="{StaticResource TextPrimary}"/>
                                <Label
                                    x:Name="SelectedDoctorSpecLabel"
                                    FontSize="13"
                                    LineBreakMode="WordWrap"
                                    Text=""
                                    TextColor="{StaticResource Accent}"/>
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="6">
                                <Label
                                    FontSize="12"
                                    Text="Date"
                                    TextColor="{StaticResource TextMuted}"/>
                                <DatePicker
                                    x:Name="AppointmentDatePicker"
                                    BackgroundColor="#102F36"
                                    DateSelected="OnAppointmentDateSelected"
                                    TextColor="White"/>
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="10">
                                <Label
                                    FontSize="12"
                                    Text="Available times"
                                    TextColor="{StaticResource TextMuted}"/>
                                <Grid
                                    x:Name="TimeSlotsGrid"
                                    ColumnSpacing="10"
                                    RowSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                </Grid>
                            </VerticalStackLayout>

                            <Button
                                x:Name="SubmitButton"
                                Clicked="OnSubmitClicked"
                                IsEnabled="False"
                                Style="{StaticResource PrimaryButton}"
                                Text="Confirm booking"/>
                    </VerticalStackLayout>
                </Border>
            </Grid>
            </controls:MainContentWrapper>
            </ScrollView>
        </Grid>
        </shared:MainLayout.PageContent>
    </shared:MainLayout>
</ContentPage>
