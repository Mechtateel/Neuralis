<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="NeuralisAPP_1.Views.Main.Controls.UserAppSidebarView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="RootSidebar">

    <Grid
        Padding="24"
        BackgroundColor="#081E24"
        RowDefinitions="Auto,*,Auto">

        <VerticalStackLayout Grid.Row="0" Spacing="28">
            <Label
                FontAttributes="Bold"
                FontSize="26"
                Text="Neuralis"
                TextColor="#3FE0C5"/>
            <VerticalStackLayout Spacing="8">
                <Border x:Name="NavDashboard" Style="{StaticResource SidebarItemStyle}">
                    <Label x:Name="LabelDashboard" Text="Dashboard" TextColor="#9FBFC4"/>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnDashboardTapped"/>
                    </Border.GestureRecognizers>
                </Border>
                <Border x:Name="NavBookVisit" Style="{StaticResource SidebarItemStyle}">
                    <Label x:Name="LabelBookVisit" Text="Book a visit" TextColor="#9FBFC4"/>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBookVisitTapped"/>
                    </Border.GestureRecognizers>
                </Border>
                <Border x:Name="NavAppointments" Style="{StaticResource SidebarItemStyle}">
                    <Label x:Name="LabelAppointments" Text="My appointments" TextColor="#9FBFC4"/>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnAppointmentsTapped"/>
                    </Border.GestureRecognizers>
                </Border>
                <Border x:Name="NavLatestNews" Style="{StaticResource SidebarItemStyle}">
                    <Label x:Name="LabelLatestNews" Text="Latest news" TextColor="#9FBFC4"/>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnLatestNewsTapped"/>
                    </Border.GestureRecognizers>
                </Border>
            </VerticalStackLayout>
        </VerticalStackLayout>

        <Grid Grid.Row="1"/>

        <VerticalStackLayout Grid.Row="2" Spacing="10">
            <BoxView HeightRequest="1" BackgroundColor="#163F46"/>
            <Grid
                x:Name="SidebarProfileHeader"
                Padding="8"
                ColumnDefinitions="Auto,*,Auto">
                <Label
                    FontFamily="MaterialIcons"
                    FontSize="20"
                    Text="person"
                    TextColor="#9FBFC4"/>
                <Label
                    x:Name="UserNameLabel"
                    Grid.Column="1"
                    Text="User"
                    TextColor="White"
                    VerticalOptions="Center"/>
                <Label
                    Grid.Column="2"
                    FontFamily="MaterialIcons"
                    FontSize="20"
                    Text="expand_less"
                    TextColor="#9FBFC4"
                    VerticalOptions="Center"/>
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnProfileHeaderTapped"/>
                </Grid.GestureRecognizers>
            </Grid>
            <VerticalStackLayout
                x:Name="SidebarProfileMenu"
                Padding="32,0,0,6"
                IsVisible="False"
                Spacing="10">
                <Label x:Name="LabelProfile" Text="Profile" TextColor="#9FBFC4">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnProfileMenuTapped"/>
                    </Label.GestureRecognizers>
                </Label>
                <Label x:Name="LabelSettings" Text="Settings" TextColor="#9FBFC4">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSettingsMenuTapped"/>
                    </Label.GestureRecognizers>
                </Label>
                <Label Text="Logout" TextColor="#FF6B6B">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnLogoutTapped"/>
                    </Label.GestureRecognizers>
                </Label>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </Grid>
</ContentView>
